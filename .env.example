# Public/server API base for the Kastrick backend.
RBE_API_BASE=https://kastrick-backend.onrender.com
NEXT_PUBLIC_RBE_API_BASE=https://kastrick-backend.onrender.com

# Server-only Developer Portal UAC credentials. Never prefix these with NEXT_PUBLIC_.
# DEVELOPER_PORTAL_UAC_PROXY_TOKEN must match KASTRICK_UAC_PROXY_TOKEN on the trusted publisher.
DEVELOPER_PORTAL_UAC_PROXY_TOKEN=replace-with-the-uac-proxy-token
DEVELOPER_PORTAL_UAC_EMAIL_INDEX_KEY=replace-with-a-random-32-plus-character-email-index-key
DEVELOPER_PORTAL_UAC_USERNAME_INDEX_KEY=replace-with-a-different-random-32-plus-character-username-index-key
