# Public/server API base for the Kastrick backend.
RBE_API_BASE=https://kastrick-backend.onrender.com
NEXT_PUBLIC_RBE_API_BASE=https://kastrick-backend.onrender.com

# Server-only UAC credentials. Never prefix these with NEXT_PUBLIC_.
# Must match KASTRICK_UAC_PROXY_TOKEN on the trusted publisher.
DEVELOPER_PORTAL_UAC_PROXY_TOKEN=replace-with-the-uac-proxy-token

# GLOBAL UAC identity indexes. These are not Developer-Portal-specific: every
# Kastrick application that participates in UAC must use the same stable values
# so the same email/username resolves to the same UAC account everywhere.
KASTRICK_UAC_EMAIL_INDEX_KEY=replace-with-one-stable-random-32-plus-character-global-email-key
KASTRICK_UAC_USERNAME_INDEX_KEY=replace-with-one-stable-random-32-plus-character-global-username-key

# Legacy compatibility only. The portal falls back to these names while old
# deployments are migrated. Do not intentionally give them different values
# from the global keys above.
DEVELOPER_PORTAL_UAC_EMAIL_INDEX_KEY=
DEVELOPER_PORTAL_UAC_USERNAME_INDEX_KEY=
